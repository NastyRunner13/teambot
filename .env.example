# Copy to .env and fill in. Never commit .env.

# Required: your OpenRouter key (https://openrouter.ai/keys). All agents use OpenRouter as their model pool.
OPENROUTER_API_KEY=

# Model used by new agents unless you pick another one in the UI.
TEAMBOT_DEFAULT_MODEL=anthropic/claude-sonnet-5.5
# Cheap model for housekeeping (summarising long runs).
TEAMBOT_UTILITY_MODEL=openai/gpt-6-luna
# Model that reviews actions sent to it by "review" policy rules (defaults to the utility model).
TEAMBOT_REVIEWER_MODEL=

# Your display name in the workspace.
TEAMBOT_USER_NAME=Owner

# Server
PORT=8787
# Keep 127.0.0.1 unless you have turned on team sign-in (Settings → Team) and put TeamBot behind HTTPS.
HOST=127.0.0.1
TEAMBOT_DATA_DIR=./data
# The address people open TeamBot at when it isn't this machine (connector sign-ins return here), e.g. https://teambot.example.com
TEAMBOT_PUBLIC_URL=
# Local MCP servers, in the same format as Claude's .mcp.json. Remote ones with sign-in are added in Settings → Connectors.
TEAMBOT_MCP_CONFIG=mcp.json

# Agent computers
TEAMBOT_COMPUTER_IMAGE=teambot/computer:latest
# runc (default) or runsc (gVisor, Linux hosts only, must be installed in Docker first)
TEAMBOT_SANDBOX_RUNTIME=
TEAMBOT_COMPUTER_MEMORY_MB=2048
TEAMBOT_COMPUTER_CPUS=2
# Stop a computer nobody has used for this many minutes (0 keeps computers running).
TEAMBOT_COMPUTER_IDLE_MINUTES=30

# Ports for the egress proxies of agents with an internet allowlist (one per agent).
TEAMBOT_EGRESS_PORTS=18800-18999

# Limits
TEAMBOT_MAX_STEPS_PER_RUN=40
TEAMBOT_MAX_CONCURRENT_RUNS=4
TEAMBOT_COMPACT_AT_TOKENS=60000
# Agent-to-agent hops allowed without a human before the loop guard stops them.
TEAMBOT_MAX_AGENT_DEPTH=6
# Teammates one run may hand work to (ask_agent, or @mentioning agents in a channel).
TEAMBOT_MAX_HANDOFFS_PER_RUN=4
# 0 stops agents from drawing interfaces they write themselves (show_ui). Published components still work.
TEAMBOT_GENERATIVE_UI=

# OpenTelemetry: send the audit log as logs and each run as a trace (OTLP/HTTP). Off when empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=teambot

# Testing: 1 makes every agent answer with a canned echo instead of calling OpenRouter.
TEAMBOT_OFFLINE_MODELS=
